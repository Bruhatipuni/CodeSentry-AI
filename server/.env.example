# CodeSentry AI - Server Environment Variables

# Server Port
PORT=5000

# Nebius Token Factory Configuration
# Obtain your API key from Nebius AI Studio / Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Eligible NVIDIA Nemotron open-source model:
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Optional GitHub Token (for increasing GitHub API rate limits from 60 to 5000 requests/hr)
GITHUB_TOKEN=

# Optional MongoDB Connection String (If not provided, CodeSentry uses local JSON persistence in ./data/db.json)
MONGODB_URI=

# Analysis Limits
MAX_SCAN_FILES=30
MAX_FILE_SIZE_KB=250
MAX_ZIP_SIZE_MB=15
